# Future template only; keep the running application on TESTNET.
# Levier Markets MAINNET Environment Configuration Template
NETWORK_MODE=MAINNET
CHAIN_ID=4663
CHAIN_NAME=Robinhood Chain Mainnet
RPC_URL=https://your-rpc-provider.example/rpc
EXPLORER_URL=https://robinhoodchain.blockscout.com
NATIVE_CURRENCY_NAME=Ether
NATIVE_CURRENCY_SYMBOL=ETH
NATIVE_CURRENCY_DECIMALS=18

# Supabase Storage & Database
SUPABASE_URL=https://your-mainnet-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-mainnet-supabase-anon-key

# Backend API Gateway
BACKEND_API_URL=http://localhost:3001

# Token Contract Address
USDG_ADDRESS=0x0000000000000000000000000000000000000000

PROTOCOL_ADDRESSES=''

TRADING_ENABLED='false'

UI_POLL_INTERVAL_MS='15000'

RPC_TIMEOUT_MS='15000'

RPC_MAX_BODY_BYTES='65536'

RPC_MAX_RESPONSE_BYTES='2097152'

RPC_MAX_BATCH_SIZE='20'

# PROTOCOL_ADDRESSES is required JSON with usdg/oracle/registry/routers/autoProtect/leveraVault/tokens/pairs.
# Mainnet remains unsupported until a separately reviewed release. Never put private keys in this JSON.

LENDING_ENABLED='false'
LENDING_DEPLOYMENT_JSON=''
LENDING_RECEIPT_CONFIRMATIONS='2'
LENDING_RECEIPT_TIMEOUT_MS='120000'
# Mainnet remains unsupported; no testnet faucet is configured here.
USDG_FAUCET_URL=''

# Reject stale or future block timestamps in onchain Analytics.
ANALYTICS_MAX_BLOCK_AGE_SECONDS=120
ROBINHOOD_STOCK_API_URL='https://api.robinhood.com/rhj/'
REFERENCE_PRICE_POLICY_JSON='{"timeoutMs":10000,"maxResponseBytes":1048576,"maxAgeMs":60000,"maxFutureSkewMs":0,"maxSpreadBps":50,"cacheMs":15000}'
MARKET_DEPLOYMENTS_JSON='[]'

# Pyth stock reference prices: server-only credentials, never NEXT_PUBLIC.
REFERENCE_PRICE_PROVIDER=ROBINHOOD
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes/
PYTH_API_KEY=
PYTH_MAX_CONFIDENCE_BPS=50
PYTH_FEEDS_JSON={"TSLA":{"id":"16dad506d7db8da01c87581c87ca897a012a153557d4d578c3b9c9e1bc0632f1","symbol":"Equity.US.TSLA/USD"},"AMZN":{"id":"b5d0e0fa58a1f8b81498ae670ce93c872d14434b72c364885d4fa1b257cbb07a","symbol":"Equity.US.AMZN/USD"},"PLTR":{"id":"11a70634863ddffb71f2b11f2cff29f73f3db8f6d0b78c49f2b5f4ad36e885f0","symbol":"Equity.US.PLTR/USD"},"NFLX":{"id":"8376cfd7ca8bcdf372ced05307b24dced1f15b1afafdeff715664598f15a3dd2","symbol":"Equity.US.NFLX/USD"},"AMD":{"id":"3622e381dbca2efd1859253763b1adc63f7f9abb8e76da1aa8e638a57ccde93e","symbol":"Equity.US.AMD/USD"}}

# Isolate feed-level access failures; still uses only the selected Pyth source.
PYTH_REQUEST_BATCH_SIZE=1

# Application-scoped DNS resolution; original Robinhood hostname and TLS remain verified.
ROBINHOOD_TRANSPORT_JSON={"mode":"HTTPS_DNS","resolverUrl":"https://dns.google/resolve","timeoutMs":5000,"maxResponseBytes":16384,"maxTtlSeconds":60}
