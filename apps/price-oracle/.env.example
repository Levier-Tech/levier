# Read-only RH testnet source observer. No signer/database writes are implemented.
NETWORK_MODE=TESTNET
CHAIN_ID=46630
TRADING_ENABLED=false
ORACLE_WORKER_MODE=DISABLED
ROBINHOOD_STOCK_API_URL=https://api.robinhood.com/rhj/
ORACLE_POLL_INTERVAL_MS=30000
ORACLE_HTTP_TIMEOUT_MS=10000
ORACLE_MAX_RESPONSE_BYTES=1048576
ORACLE_MAX_QUOTE_AGE_MS=60000
ORACLE_MAX_FUTURE_SKEW_MS=5000
ORACLE_MAX_SPREAD_BPS=100
ORACLE_SYMBOLS_JSON='["TSLA"]'
# Supply verified token identities from the local root profile. No hardcoded addresses.
PROTOCOL_ADDRESSES=
