# Dedicated contract-only deployment profile. NEVER load this into web/backend.
# Copy to .env.mainnet.core.local (ignored) and keep permissions 0600.
# Network identity: https://docs.robinhood.com/chain/connecting/
NETWORK_MODE=MAINNET
CHAIN_ID=4663
CHAIN_NAME=Robinhood Chain
NATIVE_CURRENCY_NAME=Ether
NATIVE_CURRENCY_SYMBOL=ETH
NATIVE_CURRENCY_DECIMALS=18
EXPLORER_URL=https://robinhoodchain.blockscout.com
RPC_URL=

# Use a dedicated mainnet deployer. Do not copy a testnet signer implicitly.
PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Explicit contract administrator; may be a separately controlled multisig.
PROTOCOL_OWNER_ADDRESS=

# Fill explicit limits before any future signing. Integers in wei / gas units.
# No fallback budgets and no automatic balance top-ups.
MAINNET_MAX_TRANSACTION_GAS_WEI=
MAINNET_MAX_TOTAL_GAS_WEI=
MAINNET_MAX_FEE_PER_GAS_WEI=
MAINNET_MINIMUM_GAS_RESERVE_WEI=
MAINNET_GAS_LIMIT_BUFFER_BPS=
MAINNET_RECEIPT_CONFIRMATIONS=
MAINNET_RECEIPT_TIMEOUT_MS=

# Deployment scope is intentionally independent of application feature flags.
MAINNET_DEPLOYMENT_SCOPE=CORE_ONLY
MAINNET_CORE_BROADCAST_ENABLED=false
TRADING_ENABLED=false
LENDING_ENABLED=false
MARGIN_TRADING_ENABLED=false

# Outputs: populate only from verified mainnet deployment receipts.
MAINNET_MARKET_REGISTRY_ADDRESS=
MAINNET_LENDING_ROUTER_ADDRESS=
MAINNET_AUTO_PROTECT_ADDRESS=
MAINNET_SHORT_ROUTER_ADDRESS=
MAINNET_LEVIER_VAULT_ADDRESS=

# Vault underlying must be independently verified on mainnet, never testnet.
MAINNET_VAULT_ASSET_ADDRESS=
MAINNET_VAULT_ASSET_SYMBOL=
MAINNET_VAULT_ASSET_DECIMALS=
MAINNET_VAULT_ASSET_CODE_HASH=
MAINNET_VAULT_NAME=
MAINNET_VAULT_SYMBOL=
MAINNET_VAULT_SLUG=
MAINNET_VAULT_RISK_TIER=
