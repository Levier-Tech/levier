# Network & Web App Configuration
NETWORK_MODE=TESTNET
CHAIN_ID=46630
CHAIN_NAME=Robinhood Chain Testnet
RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/your-alchemy-api-key
