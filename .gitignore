# ==========================================
broadcast/
**/broadcast/
cache/
**/cache/
artifacts/
**/artifacts/

# ==========================================
# Environment Files & Secrets (STRICT - NEVER COMMIT)
# ==========================================
.env
.env.*
.env*.local
**/.env
**/.env.*
**/.env*.local

# Whitelist example environment templates only
!.env.example
!.env.testnet.example
!.env.mainnet.example
!**/.env.example
!**/.env.testnet.example
!**/.env.mainnet.example
!**/.env.*.example

